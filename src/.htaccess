# src/.htaccess

# Apache-Fallback für Angular-Deep-Links.
# Direkte Aufrufe wie /leistungen werden auf index.html geroutet.
# Echte Dateien, Verzeichnisse, API-Routen und Asset-Dateien bleiben unberührt.

DirectoryIndex index.html

# Komprimiert textbasierte Ressourcen. Brotli wird bevorzugt, Deflate dient als Fallback.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml font/ttf
</IfModule>

<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml font/ttf
  </IfModule>
</IfModule>

# Angular-Bundles sind durch outputHashing versioniert und können dauerhaft gecacht werden.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Ungehashte statische Assets bleiben lang genug im Browsercache, ohne Deployments dauerhaft festzuhalten.
  <FilesMatch "\.(?:woff2?|ttf|webp|avif|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Einstiegspunkte und Crawl-Dateien müssen Änderungen unmittelbar ausliefern können.
  <FilesMatch "^(?:index\.html|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_URI} !^/api(?:/|$)
  RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{2,8}(?:$|[?#])
  RewriteRule ^ /index.html [L]
</IfModule>
