DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=replace-with-production-domain.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://replace-with-production-domain.invalid
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_TRUST_PROXY_PROTO=false
DJANGO_REDIS_URL=redis://127.0.0.1:6379/1
CONTACT_RATE_LIMIT=8
CONTACT_RATE_WINDOW_SECONDS=3600
CONTACT_TRUST_X_REAL_IP=false
CONTACT_RECIPIENT=kontakt@bennewitz.de
DEFAULT_FROM_EMAIL=website@replace-with-production-domain.invalid
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_TIMEOUT=10
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
